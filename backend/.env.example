# Database
DATABASE_URL=postgresql://meu_imovel:password@localhost:5432/meu_imovel_db
DATABASE_TEST_URL=postgresql://meu_imovel:password@localhost:5433/meu_imovel_test

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=troque-por-segredo-muito-longo-e-aleatorio-min-64-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=outro-segredo-muito-longo-diferente-do-anterior-min-64-chars
JWT_REFRESH_EXPIRES_IN=30d

# App
PORT=3000
ALLOWED_ORIGINS=http://localhost:8081
NODE_ENV=development

# Cloudinary
CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=sua-api-key
CLOUDINARY_API_SECRET=seu-api-secret
